// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "lsp_results_location": "picker",
  "proxy": "",
  "title_bar": {
    "show_menus": true,
    "show_branch_status_icon": true,
  },
  "status_bar": {
    "show_active_file": true,
  },
  "scroll_beyond_last_line": "one_page",
  "preview_tabs": {
    "enable_preview_file_from_code_navigation": false,
    "enable_preview_from_multibuffer": false,
    "enable_preview_from_project_panel": false,
    "enabled": false,
  },
  "diff_view_style": "unified",
  "edit_predictions": {
    "provider": "zed",
  },
  "auto_update": true,
  "relative_line_numbers": "enabled",
  "soft_wrap": "none",
  "use_auto_surround": true,
  "use_autoclose": true,
  "document_folding_ranges": "off",
  "semantic_tokens": "combined",
  "document_symbols": "off",
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "colorize_brackets": true,
  "collaboration_panel": {
    "button": false,
    "default_width": 320.0,
  },
  "git_panel": {
    "default_width": 320.0,
  },
  "agent": {
    "flexible": false,
    "dock": "left",
    "default_profile": "ask",
    "default_model": {
      "effort": "high",
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "enable_thinking": true,
    },
    "default_width": 320.0,
  },
  "outline_panel": {
    "button": false,
    "default_width": 320.0,
  },
  "cursor_blink": false,
  "git": {
    "hunk_style": "staged_hollow",
    "inline_blame": {
      "enabled": false,
    },
  },
  "project_panel": {
    "default_width": 320.0,
    "diagnostic_badges": true,
  },
  "tabs": {
    "file_icons": false,
    "git_status": true,
    "show_diagnostics": "all",
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "code_actions": false,
  },
  "hover_popover_hiding_delay": 400,
  "hover_popover_delay": 400,
  "show_signature_help_after_edits": false,
  "auto_signature_help": false,
  "use_smartcase_search": true,
  "close_on_file_delete": true,
  "file_finder": {
    "modal_max_width": "small",
  },
  "preferred_line_length": 110,
  "scrollbar": {
    "show": "never",
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "vertical_scroll_margin": 10.0,
  "terminal": {
    "font_weight": 400.0,
    "button": true,
    "scrollbar": {
      "show": "never",
    },
    "dock": "bottom",
    "default_height": 460,
  },
  "which_key": {
    "delay_ms": 0,
    "enabled": true,
  },
  "vim": {
    "show_edit_predictions_in_normal_mode": false,
    "highlight_on_yank_duration": 270,
    "cursor_shape": {
      "visual": "underline",
    },
    "gdefault": true,
    "use_smartcase_find": true,
    "use_system_clipboard": "on_yank",
    "toggle_relative_line_numbers": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 10000,
    },
  },
  "disable_ai": true,
  "cli_default_open_behavior": "new_window",
  "buffer_line_height": {
    "custom": 1.15,
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "inlay_hints": {
    "show_background": false,
    "enabled": true,
  },
  "diagnostics": {
    "lsp_pull_diagnostics": {
      "debounce_ms": 150,
    },
    "inline": {
      "enabled": true,
    },
  },
  "helix_mode": false,
  "vim_mode": true,
  "base_keymap": "VSCode",
  // ===================== Font =============================================================================
  "buffer_font_weight": 500.0,
  "ui_font_weight": 500.0,
  "buffer_font_family": "CaskaydiaCove Nerd Font",
  "ui_font_size": 15.0,
  "buffer_font_size": 14.0,
  "buffer_font_features": {
    "calt": false
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Sonokai Custom",
  },
  "gutter": {
    "min_line_number_digits": 0,
    "runnables": true,
    "folds": true,
    "breakpoints": true,
  },
  "show_wrap_guides": false,
  "wrap_guides": [110],

  // ===== Token based highlighting of syntax ================================================================
  "global_lsp_settings": {
    "semantic_token_rules": [
      // Applies to rust
      {
        "token_type": "operator",
        "token_modifiers": ["controlFlow"],
        "foreground_color": "#FF974DFF",
      },
      {
        "token_type": "struct",
        "token_modifiers": ["library", "defaultLibrary"],
        "foreground_color": "#FF5A58FF",
      },
      {
        "token_type": "typeAlias",
        "token_modifiers": ["library"],
        "foreground_color": "#FF5A58FF",
      },
      {
        "token_type": "variable",
        "token_modifiers": ["callable"],
        "foreground_color": "#6D9EDEff"
      },
      {
        "token_type": "parameter",
        "token_modifiers": ["callable"],
        "foreground_color": "#6D9EDEff"
      },
      {
        "token_type": "decorator",
        "token_modifiers": ["library", "defaultLibrary", "attribute"],
        "foreground_color": "#D1D4E0ff",
        "background_color": "#8A90A624",
      },
      {
        "token_type": "property",
        "token_modifiers": ["library"],
        "style": ["number"],
      },
      {
        "token_type": "builtinType",
        "style": ["type.builtin"],
      },
      {
        "token_type": "typeParameter",
        "foreground_color": "#688EE3FF",
      },
      {
        "token_type": "macro",
        "foreground_color": "#A1A6FFff",
        // "foreground_color": "#FF5A58FF",
      },
      {
        "token_type": "selfTypeKeyword",
        "style": ["type.builtin"],
      },
      {
        "token_type": "property",
        "foreground_color": "#E8E3DCFF",
      },
      // Applies to Go
      {
        "token_type": "type",
        "token_modifiers": ["definition", "interface"],
        "style": ["enum"]
      }
    ],
  },
  // ===== Language Configurations ==========================================================
  "languages": {
    "Markdown": {
      "language_servers": ["marksman"]
    }
  },
  // ===== Lsp Configuration ================================================================
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": 10
        }
      }
    }
  },
  "dap": {
    "CodeLLDB": {
      "binary": "~/.codelldb-custom/extension/adapter/codelldb"
    },
  },
  // "dap": {
  //   "CodeLLDB": {
  //     "binary": "/opt/homebrew/opt/llvm/bin/lldb-dap"
  //   },
  // },
}
